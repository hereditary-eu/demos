---
import { Badge, Card } from "@astrojs/starlight/components";
import Image from "astro/components/Image.astro";
import StatusFlare from "./StatusFlare.astro";
const {
  title,
  image,
  link,
  local_link,
  code,
  paper,
  video,
  contact,
  documentation,
} = Astro.props;
const paperTitle = Astro.props["paper-title"];
const linkSystem = local_link || link;
---

<Card title={title}>
  <div class="demo-image-wrapper">
    <a href={linkSystem} target="_blank">
      <Image src={image} alt={title} style="margin-bottom: 10px;" />
    </a>
  </div>
  <slot />
  <div style="display: flex; gap: 5px; justify-content: right;">
    {
      local_link && (
        <a href={local_link} target="_blank">
          <Badge text="More Information" variant="default" />
        </a>
      )
    }
    {
      linkSystem && (
        <a href={linkSystem} target="_blank">
          <Badge text="Live Demo" variant="danger" />
        </a>
      )
    }
    {
      documentation && (
        <a href={documentation}>
          <Badge text="Documentation" variant="default" />
        </a>
      )
    }
    {
      code && (
        <a href={code}>
          <Badge text="Code Available" variant="tip" />
        </a>
      )
    }
    {
      paper && (
        <a href={paper} title={paperTitle}>
          <Badge text="Paper" variant="success" />
        </a>
      )
    }
    {
      video && (
        <a href={video} target="_blank">
          <Badge text="Video" variant="caution" />
        </a>
      )
    }
  </div>
  <div class="demo-footer">
    {link && <StatusFlare url={link} />}
    <p class="demo-contact">Contact: {contact}</p>
  </div>
</Card>

<style>
  .demo-image-wrapper {
    position: relative;
  }

  .demo-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
    gap: 8px;
  }

  .demo-contact {
    margin: 0 0 0 auto;
    text-align: right;
  }
</style>
