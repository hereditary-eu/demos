---
import { Badge, Card } from "@astrojs/starlight/components";
import Image from "astro/components/Image.astro";
const { title, image, link, code, paper, contact, documentation } = Astro.props;
const paperTitle = Astro.props["paper-title"];
---

<Card title={title}>
  <div class="demo-image-wrapper">
    <a href={link}>
      <Image src={image} alt={title} style="margin-bottom: 10px;" />
    </a>
  </div>
  <slot />
  <div style="display: flex; gap: 5px; justify-content: right;">
    {
      link && (
        <a href={link}>
          <Badge text="Live Demo" variant="default" />
        </a>
      )
    }
    {
      documentation && (
        <a href={documentation}>
          <Badge text="Documentation" variant="default" />
        </a>
      )
    }
    {
      code && (
        <a href={code}>
          <Badge text="Code Available" variant="tip" />
        </a>
      )
    }
    {
      paper && (
        <a href={paper} title={paperTitle}>
          <Badge text="Paper" variant="success" />
        </a>
      )
    }
  </div>
  <div class="demo-footer">
    {link && (
      <span class="status-flare" data-url={link}>
        <span class="status-dot"></span>
        <span class="status-text">Checking…</span>
      </span>
    )}
    <p class="demo-contact">Contact: {contact}</p>
  </div>
</Card>

<style>
  .demo-image-wrapper {
    position: relative;
  }

  .demo-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
    gap: 8px;
  }

  .demo-contact {
    margin: 0;
    text-align: right;
  }

  /* --- status flare wrapper --- */
  .status-flare {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  /* --- dot --- */
  .status-dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #888;
    flex-shrink: 0;
    animation: sf-pulse 1.6s ease-in-out infinite;
  }

  .status-flare[data-status="online"] .status-dot {
    background: #22c55e;
    animation: sf-blink 2.4s ease-in-out infinite;
  }

  .status-flare[data-status="online"] .status-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #22c55e;
    opacity: 0;
    animation: sf-ring 2.4s ease-out infinite;
  }

  .status-flare[data-status="offline"] .status-dot {
    background: #ef4444;
    animation: none;
  }

  /* --- label --- */
  .status-text {
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }

  .status-flare[data-status="online"] .status-text {
    color: #22c55e;
  }

  .status-flare[data-status="offline"] .status-text {
    color: #ef4444;
  }

  @keyframes sf-pulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }

  @keyframes sf-blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.65; transform: scale(0.88); }
  }

  @keyframes sf-ring {
    0% { transform: scale(0.6); opacity: 0.8; }
    100% { transform: scale(1.8); opacity: 0; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll<HTMLElement>(".status-flare[data-url]").forEach(async (flare) => {
      const url = flare.dataset.url!;
      const text = flare.querySelector<HTMLElement>(".status-text")!;
      try {
        await fetch(url, { mode: "no-cors", signal: AbortSignal.timeout(7000) });
        flare.dataset.status = "online";
        text.textContent = "Online";
      } catch {
        flare.dataset.status = "offline";
        text.textContent = "Offline";
      }
    });
  });
</script>
