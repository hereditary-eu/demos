---
import { getCollection, render } from "astro:content";
import { getSystems } from "../../systems";
import { marked } from "marked";
import { baseUrl } from "marked-base-url";
import markedKatex from "marked-katex-extension";
import "katex/dist/katex.min.css";

import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import DemoPageHeader from "../../components/DemoPageHeader.astro";

export async function getStaticPaths() {
  const systems = await getCollection("systems");
  return systems.map((system) => ({
    params: { id: system.id },
    props: { system: system },
  }));
}
const { system } = Astro.props;
const sidebar = [
  {
    label: "Demos",
    items: (await getSystems()).map((s) => ({ label: s.data.title, link: `/systems/${s.id}` })),
  },
];
const { Content } = await render(system);
const GH_TOKEN = import.meta.env.GH_TOKEN || process.env.GH_TOKEN;
if (!GH_TOKEN) {
  console.warn("GH_TOKEN is not set. Please set it in your environment variables to increase API rate limits.");
}

async function ghFetch(url: string): Promise<Response> {
  const response = await fetch(url, GH_TOKEN ? { headers: { Authorization: `token ${GH_TOKEN}` } } : {});
  if (!response.ok) {
    throw new Error(`Failed to fetch ${url}: ${response.status} ${response.statusText}`);
  }
  return response;
}

async function fetchReadme(codeUrl: string): Promise<string> {
  const branches = await (
    await ghFetch(codeUrl.replace("https://github.com", "https://api.github.com/repos") + "/branches")
  ).json();
  const mainBranchName = branches[0]?.name || "main";
  const readmeContent = await (await ghFetch(`${codeUrl}/raw/${mainBranchName}/README.md`)).text();
  marked.use(markedKatex({ throwOnError: false, nonStandard: true }));
  const base = `${codeUrl}/raw/${mainBranchName}/`;
  marked.use(baseUrl(base));
  // marked-base-url only rewrites markdown links/images, not raw HTML tags in the README
  return (marked.parse(readmeContent) as string).replace(
    /(<(?:img|a|source)\b[^>]*?\s(?:src|href)=")(?!\w+:|\/\/|#)\.?\/?/gi,
    `$1${base}`,
  );
}

let readmeContent: string | null = null;
if (system.data.code?.startsWith("https://github.com")) {
  const codeUrl = system.data.code.trimEnd().replace(/\/$/, ""); // remove trailing slash if present
  try {
    readmeContent = await fetchReadme(codeUrl);
  } catch (error) {
    console.warn(`Could not render README for system "${system.id}" (${codeUrl}):`, error);
  }
} else {
  console.log("System does not have a GitHub repository:", system.id);
}
---

<StarlightPage frontmatter={{ title: system.data.title, tableOfContents: false }} sidebar={sidebar}>
  <DemoPageHeader
    title={system.data.title}
    image={system.data.image}
    link={system.data.link}
    local_link=`/systems/${system.id}`
    code={system.data.code}
    paper={system.data.paper}
    video={system.data.video}
    contact={system.data.contact}
    documentation={system.data.documentation}
  />
  {
    system.data.link && (
      <a class="start-demo" href={system.data.link}>
        <span class="start-icon">&#9658;</span>
        Open the Demo
      </a>
    )
  }
  <Content />
  {readmeContent && <div class="readme" set:html={readmeContent} />}
</StarlightPage>

<style is:global>
  html:root {
    --sl-content-width: 54rem;
  }
</style>

<style>
  .readme {
    min-width: 0;
  }
  .readme :global(img) {
    display: inline-block; /* Starlight makes images block-level, breaking side-by-side <img> rows */
  }
  .readme :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .start-demo {
    display: block;
    width: fit-content;
    text-decoration: none;
    align-items: center;
    gap: 0.6em;
    padding: 0.6em 1.2em;
    font-size: 1.25rem;
    font-weight: 600;
    color: white;
    background: #2e7d32;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    margin: 20px auto;
  }
  .start-demo:hover {
    filter: brightness(1.15);
  }
  .start-icon {
    font-size: 1.1em;
    line-height: 1;
    margin-left: -5px;
    margin-right: 5px;
  }
</style>
